<?xml version="1.0" encoding="utf-8"?>
<!-- van-core serves plain HTTP on its SoftAP; there is no certificate to be had
     offline. Allowed app-wide: an IP literal in <domain-config> is not matched
     on every Android version, and this app only ever talks to the van. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
