<?xml version="1.0" encoding="utf-8"?>
<!-- Compact widget, 2x1: state of charge and AC state only. Same ids as
     van_widget.xml for what it shows; the rest is simply absent. The battery
     (w_fill + w_soc) is the same vessel as the full layout, smaller. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/widget_pad"
    android:paddingEnd="4dp">

    <FrameLayout
        android:layout_width="78dp"
        android:layout_height="42dp">

        <ImageView
            android:id="@+id/w_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/w_soc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingEnd="4dp"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="--"
            android:textColor="@color/fg"
            android:textSize="24sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/dot"
                android:tint="@color/dim" />

            <TextView
                android:id="@+id/w_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="--"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/dim"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/w_refresh_box"
        android:layout_width="36dp"
        android:layout_height="36dp">

        <ImageView
            android:id="@+id/w_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/w_refresh"
            android:padding="9dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/muted" />

        <ProgressBar
            android:id="@+id/w_spin"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/warn"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
