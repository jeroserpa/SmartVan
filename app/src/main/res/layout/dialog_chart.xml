<?xml version="1.0" encoding="utf-8"?>
<!-- One History chart, full screen, to be explored (ChartExplorer, D-28).
     The plot takes everything the bars above and below do not. The buttons
     at the bottom do what the gestures do, for one hand, a cold thumb or a
     bumpy road. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/x_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/x_close"
            android:src="@drawable/ic_close"
            app:tint="@color/muted" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/x_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/fg"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/x_window"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/x_reset"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/x_reset"
            android:textColor="@color/warn" />
    </LinearLayout>

    <!-- Min, max and mean of each shown series, over what is in view. -->
    <TextView
        android:id="@+id/x_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingHorizontal="16dp"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <van.supervisor.app.ChartView
        android:id="@+id/x_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/x_earlier"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/x_earlier"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="‹"
            android:textColor="@color/fg"
            android:textSize="24sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/x_out"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/x_zoom_out"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="−"
            android:textColor="@color/fg"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/x_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/x_hint"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/x_in"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/x_zoom_in"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="+"
            android:textColor="@color/fg"
            android:textSize="22sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/x_later"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/x_later"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="›"
            android:textColor="@color/fg"
            android:textSize="24sp" />
    </LinearLayout>
</LinearLayout>
