<?xml version="1.0" encoding="utf-8"?>
<!-- GENERATED from van_widget.xml by tools/make_widget_preview.py, for the
     widget picker. Do not edit; regenerate. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/w_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/battery_fill_preview"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/widget_pad"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <!-- Header: identity left, AC state chip right. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bolt"
                android:tint="@color/warn" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/w_title"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/w_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/dot"
                android:tint="@color/warn" />

            <TextView
                android:id="@+id/w_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="AC on"
                android:textColor="@color/warn"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hero: state of charge, power flows beside it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/w_soc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="78%"
                android:textColor="@color/fg"
                android:textSize="40sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="4dp"
                        android:id="@+id/w_ic_in"
                        android:contentDescription="Input"
                        android:src="@drawable/ic_arrow_in"
                        android:tint="@color/ok" />

                    <TextView
                        android:id="@+id/w_in"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="310 W in"
                        android:textColor="@color/fg"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="4dp"
                        android:id="@+id/w_ic_out"
                        android:contentDescription="Output"
                        android:src="@drawable/ic_arrow_out"
                        android:tint="@color/warn" />

                    <TextView
                        android:id="@+id/w_out"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="48 W out"
                        android:textColor="@color/fg"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Both probes. Two numbers with no label would be a guessing game,
             so each carries its own, small and muted, the way the power flows
             carry "in" and "out". Cabin is the ambient one: it is what the
             fridge is working against, so the pair reads as a cause and an
             effect rather than as two thermometers. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="4dp"
                android:id="@+id/w_ic_fridge"
                android:contentDescription="Fridge"
                android:src="@drawable/ic_snow"
                android:tint="@color/alt" />

            <TextView
                android:id="@+id/w_fridge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="4.6 °C fridge"
                android:textColor="@color/fg"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="4dp"
                android:id="@+id/w_ic_cabin"
                android:contentDescription="Cabin"
                android:src="@drawable/ic_thermo"
                android:tint="@color/muted" />

            <TextView
                android:id="@+id/w_cabin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="24.0 °C cabin"
                android:textColor="@color/fg"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Footer: why the AC is where it is, how old the reading is, refresh. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_reason"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:text="fridge block"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/w_age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:text="14:32"
                android:maxLines="1"
                android:textColor="@color/dim"
                android:textSize="11sp" />

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">

                <ImageView
                    android:id="@+id/w_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/w_refresh"
                    android:padding="9dp"
                    android:src="@drawable/ic_refresh"
                    android:tint="@color/muted" />

                <ProgressBar
                    android:id="@+id/w_spin"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/warn"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
