<?xml version="1.0" encoding="utf-8"?>
<!-- Two tabs at the TOP, not the bottom, and that is deliberate: ui/index.html
     carries its own fixed bottom nav (Power / Fridge / Setup / Diag), so an
     app-level bottom bar would stack two rows of tabs on one screen. The app's
     chrome above, the page's chrome below, visibly different things. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        app:tabIndicatorColor="@color/warn"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="2dp"
        app:tabSelectedTextColor="@color/warn"
        app:tabTextColor="@color/dim" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <FrameLayout
        android:id="@+id/page_dashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:overScrollMode="never" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Shown when the page is up but the Wi-Fi dropped: keep the last values
         visible, clearly marked, rather than blanking the screen. -->
    <TextView
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/banner_bg"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="@string/st_lost_banner"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="@color/warn"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_wifi_off"
        app:drawableTint="@color/warn" />

    <!-- Everything that is not the page: searching, connecting, errors. -->
    <ScrollView
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:fillViewport="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingVertical="48dp">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/panel_icon"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_launcher_foreground" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/panel_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    app:indicatorColor="@color/warn"
                    app:indicatorSize="88dp"
                    app:trackThickness="3dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/panel_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/st_searching_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/fg" />

            <TextView
                android:id="@+id/panel_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxWidth="360dp"
                android:text="@string/st_searching_body"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/muted" />

            <LinearLayout
                android:id="@+id/panel_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_wifi"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="@string/btn_wifi"
                    android:textColor="@color/fg"
                    app:strokeColor="@color/line" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_retry" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_details"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btn_details"
                android:textColor="@color/muted"
                android:visibility="gone" />

            <TextView
                android:id="@+id/panel_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/card"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:textColor="@color/muted"
                android:textIsSelectable="true"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
    </FrameLayout>

    <!-- The native half. Inflated here so it keeps its state across tab
         switches; it holds a database handle and a worker thread. -->
    <FrameLayout
        android:id="@+id/page_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <include layout="@layout/view_history" />
    </FrameLayout>
</LinearLayout>
