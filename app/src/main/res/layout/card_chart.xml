<?xml version="1.0" encoding="utf-8"?>
<!-- One chart with a title, a one-line reading of what it says, and the plot.
     The sentence matters as much as the plot: a number nobody can interpret
     is the state docs/measurements.md was already in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/c_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/fg"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/c_read"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <van.supervisor.app.ChartView
        android:id="@+id/c_chart"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="8dp" />
</LinearLayout>
