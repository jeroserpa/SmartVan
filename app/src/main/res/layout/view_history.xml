<?xml version="1.0" encoding="utf-8"?>
<!-- The native half of the app (docs/decisions.md D-22). Everything here is
     about data the node cannot keep: its ring is volatile PSRAM and holds
     ~4.3 days, this holds everything, forever, and works out of range. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp">

        <!-- Archive + sync -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/h_archive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/fg"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/h_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/h_sync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/h_sync" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/h_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/warn"
                    app:indicatorSize="20dp"
                    app:trackThickness="2dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/h_export"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/h_export"
                    android:textColor="@color/muted" />
            </LinearLayout>
        </LinearLayout>

        <!-- Range -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/h_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/h_range_1d"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/h_range_1d" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/h_range_3d"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/h_range_3d" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/h_range_7d"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/h_range_7d" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/h_range_all"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/h_range_all" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Temperatures -->
        <include
            android:id="@+id/card_temp"
            layout="@layout/card_chart" />

        <!-- Power -->
        <include
            android:id="@+id/card_power"
            layout="@layout/card_chart" />

        <!-- Station overhead: the §8.2 number, the one no register reports -->
        <include
            android:id="@+id/card_overhead"
            layout="@layout/card_chart" />

        <!-- Duty -->
        <include
            android:id="@+id/card_duty"
            layout="@layout/card_chart" />

        <!-- Episodes: coast rate, and the pulldown penalty's raw material -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/h_ep_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/h_episodes"
                android:textColor="@color/fg"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/h_ep_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/h_ep_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:textColor="@color/muted"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
