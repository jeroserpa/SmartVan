# The UI assets are hashed byte-for-byte by tools/pack_ui.py and the resulting
# bytes are served straight out of flash. With core.autocrlf=true a Windows
# checkout gets CRLF on disk, so the hash never matches the committed header
# and CRLF ends up baked into the served page. Pin them.
ui/*.html          text eol=lf
ui/*.webmanifest   text eol=lf
ui/*.png           binary

# Generated by tools/pack_ui.py. LF here keeps regeneration from churning the
# whole file on a Windows machine.
components/van_ui/van_ui_html.h text eol=lf
